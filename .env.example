# Copia para .env e preenche. O .env nunca e commitado.

# Conta Gmail que envia o digest
SMTP_UTILIZADOR=

# App Password de 16 caracteres (myaccount.google.com/apppasswords).
# NAO e a password normal da conta.
SMTP_PASSWORD=

# Endereco que recebe o digest
EMAIL_DESTINO=

# "gemini" (Google AI Studio) ou "groq". Deixa vazio para desligar o LLM.
LLM_PROVIDER=gemini
LLM_API_KEY=
